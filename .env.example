# Copy this file to ".env" (same folder) and fill in the key.
# run_voice_pubmed_bot.command loads .env automatically; .env is gitignored.

# Meta Model API key, from https://dev.meta.ai (API keys > Create API key).
# Enables Muse Voice Transcribe streaming speech-to-text (~$0.18 / audio-hour).
# Omit it and the bot falls back to the free Google recognizer.
MODEL_API_KEY=

# OpenAI Nova speech output. Separate from MODEL_API_KEY.
OPENAI_API_KEY=
